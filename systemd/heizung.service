[Unit]
Description=Heizung UVR1611 daemon (firing control + Prometheus metrics exporter)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/raspberry-pi-heizung
Environment=HEIZUNG_CONFIG_PATH=/home/pi/raspberry-pi-heizung
ExecStart=/home/pi/raspberry-pi-heizung/venv/bin/python -m heizung
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

[Unit]
Description=Heizung UVR1611 API (FastAPI, Prometheus-backed chart endpoint)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/raspberry-pi-heizung
Environment=HEIZUNG_CONFIG_PATH=/home/pi/raspberry-pi-heizung
ExecStart=/home/pi/raspberry-pi-heizung/venv/bin/uvicorn heizung.api:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
